{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/parque3d", "destination": "/parque3d/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/ranking-tv", "destination": "/index.html" },
    { "source": "/ranking", "destination": "/index.html" },
    { "source": "/tv", "destination": "/index.html" },
    { "source": "/controle", "destination": "/controle.html" },
    { "source": "/mobile", "destination": "/controle.html" },
    { "source": "/parque3d", "destination": "/parque3d/index.html" },
    { "source": "/parque3d/", "destination": "/parque3d/index.html" },
    { "source": "/parque3d/:path*", "destination": "/parque3d/:path*" },
    { "source": "/api/ranking", "destination": "/api/ranking" },
    { "source": "/api/network-info", "destination": "/api/network-info" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Range" }
      ]
    },
    {
      "source": "/public/media/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Accept-Ranges", "value": "bytes" }
      ]
    },
    {
      "source": "/public/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
